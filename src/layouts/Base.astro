---
import '@fontsource-variable/manrope';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import { contacts, organization } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = organization.title,
  description = organization.description,
} = Astro.props;

const canonical = organization.url;
const ogImage = `${organization.url}assets/img/og-cover.jpg`;

const employmentAgency = {
  '@context': 'https://schema.org',
  '@type': 'EmploymentAgency',
  '@id': `${organization.url}#organizacao`,
  name: organization.name,
  alternateName: organization.shortName,
  url: organization.url,
  description,
  image: ogImage,
  logo: `${organization.url}assets/img/icon-512.png`,
  telephone: `+${contacts.primary.phone.slice(0, 2)}-${contacts.primary.phone.slice(2, 4)}-${contacts.primary.phone.slice(4)}`,
  email: organization.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rua Paulo César Fidelis, 39, Sala 311, Villa Bella',
    addressLocality: 'Campinas',
    addressRegion: 'SP',
    addressCountry: 'BR',
  },
  areaServed: [
    { '@type': 'City', name: 'Campinas' },
    { '@type': 'AdministrativeArea', name: 'Região Metropolitana de Campinas' },
    { '@type': 'Country', name: 'Brasil' },
  ],
  sameAs: [organization.instagram, organization.linkedin],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#115f61" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={organization.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={organization.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />
    <link rel="preload" as="image" href="/assets/img/equipe-grupo-2.jpg" fetchpriority="high" />
    <link rel="manifest" href="/site.webmanifest" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(employmentAgency)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
