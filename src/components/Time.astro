---
import { team } from '../data/site';
---

<section class="section team" id="equipe" aria-labelledby="team-title">
  <div class="container">
    <header class="section-intro reveal">
      <h2 id="team-title">Quem conduz cada processo</h2>
      <p>Profissionais que combinam escuta, repertório e responsabilidade em cada decisão.</p>
    </header>

    <div class="team-layout">
      {team.map((member, index) => (
        <article class:list={['team-person', { 'team-person-featured': index === 0 }, 'reveal']}>
          <img
            src={`/assets/img/${member.image}`}
            alt={member.name}
            loading="lazy"
            width="640"
            height="800"
          />
          <div class="team-person-copy">
            <h3>{member.name}</h3>
            <p class="team-role">{member.role}</p>
            <p>{member.bio}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
