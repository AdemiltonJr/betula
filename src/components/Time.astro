---
const time = [
  {
    img: 'team-luciana-alvim.jpg',
    nome: 'Luciana Alvim',
    cargo: 'Fundadora · Psicóloga',
    bio: 'Fundadora da Bétula, psicóloga, pedagoga social, pós-graduada em Gestão Estratégica de Recursos Humanos e Negócios, analista comportamental e grafóloga. Atua há 20 anos com recrutamento, seleção e avaliação de candidatos, assessorando empresas de diversos portes e segmentos.',
  },
  {
    img: 'team-georgia-frattini.jpg',
    nome: 'Georgia Frattini',
    cargo: 'Consultora · Coach executiva',
    bio: 'Administradora de empresas, pós-graduada em Gestão Estratégica de Pessoas e Negócios, em Dinâmica de Grupos e coach executiva. Atua há 15 anos com desenvolvimento de pessoas, recrutamento, seleção e avaliação de candidatos. Carreira desenvolvida em multinacionais e consultoria.',
  },
  {
    img: 'team-vanessa-luiz.jpg',
    nome: 'Vanessa Luiz',
    cargo: 'Consultora · Analista comportamental',
    bio: 'Administradora de empresas, pós-graduada em Gestão Estratégica de Pessoas e analista comportamental. Atua há 18 anos com recursos humanos de forma generalista, em multinacionais de grande e médio porte nos segmentos de embalagens, papel e celulose, alimentício e serviços.',
  },
];

const teamSchema = {
  '@context': 'https://schema.org',
  '@graph': time.map((p) => ({
    '@type': 'Person',
    name: p.nome,
    jobTitle: p.cargo.split(' · ')[0],
    description: p.bio,
    image: `https://betularh.com.br/assets/img/${p.img}`,
    worksFor: {
      '@type': 'Organization',
      '@id': 'https://betularh.com.br/#organizacao',
      name: 'Bétula RH',
    },
  })),
};
---

<section class="section equipe" id="equipe">
  <div class="container">
    <header class="section-head reveal">
      <span class="kicker">Time Bétula</span>
      <h2>Gente que entende de gente.</h2>
    </header>
    <div class="team-grid team-grid-3">
      {
        time.map((p) => (
          <article class="team-card reveal">
            <img src={`/assets/img/${p.img}`} alt={p.nome} loading="lazy" width="400" height="400" />
            <h3>{p.nome}</h3>
            <span class="team-role">{p.cargo}</span>
            <p>{p.bio}</p>
          </article>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(teamSchema)} />
</section>
