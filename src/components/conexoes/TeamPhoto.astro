---
interface Person {
  name: string;
  position: string;
  left: number;
  top: number;
  width: number;
  height: number;
}
interface Props { people?: Person[]; }
// Only names explicitly confirmed for positions in this photograph belong here.
const { people = [] } = Astro.props;
---
<figure class="team-wide reveal team-photo" data-team-photo>
  <img src="/assets/img/equipe-grupo-2.jpg" alt="Equipe Bétula reunida no escritório" width="1400" height="932" loading="lazy" />
  {people.map((person, index) => (
    <button
      type="button"
      class="team-person"
      aria-label={`${person.name}, ${person.position}`}
      aria-describedby={`team-person-label-${index}`}
      data-team-person
      style={`--person-left:${person.left}%;--person-top:${person.top}%;--person-width:${person.width}%;--person-height:${person.height}%;`}
    >
      <svg class="team-person-trace" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path d="M 20 60 V 63 Q 20 66 26 68 L 50 73 V 76" pathLength="1" />
      </svg>
      <span class="team-person-origin" aria-hidden="true"></span>
      <span class="team-person-label" id={`team-person-label-${index}`} role="tooltip" aria-label={person.name}>
        <span class="team-person-name" aria-hidden="true">{Array.from(person.name).map((letter, letterIndex) => <span class="name-letter" style={`--letter-index:${letterIndex}`}>{letter}</span>)}</span>
      </span>
    </button>
  ))}
</figure>
{people.length > 0 && <p class="team-photo-hint"><span class="pointer-hint">Passe o mouse sobre uma pessoa para conhecê-la.</span><span class="touch-hint">Toque em uma pessoa para ver o nome.</span></p>}

<style>
  .team-photo { position: relative; aspect-ratio: 1400 / 932; width: min(100%, calc((100svh - 180px) * 1.5021459)); margin-inline: auto; container-type: inline-size; }
  .team-person { --callout-opacity: 0; --callout-visibility: hidden; --trace-animation: none; --letter-animation: none; --origin-animation: none; position: absolute; left: var(--person-left); top: var(--person-top); width: var(--person-width); height: var(--person-height); padding: 0; border: 0; border-radius: 20%; background: transparent; cursor: pointer; }
  .team-person:focus-visible { outline: 2px solid var(--sand); outline-offset: -3px; background: rgb(17 95 97 / .06); }
  .team-person-trace { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; opacity: var(--callout-opacity); pointer-events: none; filter: drop-shadow(0 1px 2px rgb(35 35 35 / .35)); }
  .team-person-trace path { fill: none; stroke: var(--sand); stroke-width: .55; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: var(--trace-animation) .48s cubic-bezier(.4, 0, .2, 1) .08s both; }
  .team-person-origin { position: absolute; top: 60%; left: 20%; width: 9px; height: 9px; border: 2px solid var(--sand); border-radius: 50%; background: var(--bronze); transform: translate(-50%, -50%); opacity: var(--callout-opacity); box-shadow: 0 0 0 4px rgb(240 233 222 / .18); pointer-events: none; animation: var(--origin-animation) .3s ease-out both; }
  .team-person-label { position: absolute; left: 50%; top: 76%; transform: translateX(-50%); padding: 9px 15px 10px; border-radius: 2px; background: rgb(250 250 248 / .96); color: var(--teal); border-bottom: 2px solid var(--bronze); font: 500 15px/1.3 var(--title); letter-spacing: -.025em; white-space: nowrap; opacity: var(--callout-opacity); visibility: var(--callout-visibility); transition: opacity .15s; pointer-events: auto; }
  .team-person-label { top: 76%; }
  .team-person-name { white-space: pre; }
  .team-person-label { animation: var(--panel-animation, none) .18s ease-out .35s both; }
  .name-letter { display: inline-block; opacity: 0; animation: var(--letter-animation) .12s ease-out calc(.6s + var(--letter-index) * .035s) both; }
  .team-person:is(:focus-visible, .is-active):not(.is-dismissed) { --callout-opacity: 1; --callout-visibility: visible; --trace-animation: draw-connection; --letter-animation: write-letter; --origin-animation: reveal-origin; }
  @media (hover: hover) { .team-person:hover:not(.is-dismissed) { --callout-opacity: 1; --callout-visibility: visible; --trace-animation: draw-connection; --letter-animation: write-letter; --origin-animation: reveal-origin; } }
  @keyframes draw-connection { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes write-letter { from { opacity: 0; } to { opacity: 1; } }
  @keyframes reveal-origin { from { transform: translate(-50%, -50%) scale(.4); } to { transform: translate(-50%, -50%) scale(1); } }
  .team-person:is(:focus-visible, .is-active):not(.is-dismissed) { --panel-animation: reveal-nameplate; }
  @media (hover: hover) { .team-person:hover:not(.is-dismissed) { --panel-animation: reveal-nameplate; } }
  @keyframes reveal-nameplate { from { opacity: 0; } to { opacity: 1; } }
  .team-photo-hint { width: min(100%, calc((100svh - 180px) * 1.5021459)); margin: 15px auto 0; color: var(--muted); font-size: 13px; }
  .touch-hint { display: none; }
  @container (max-width: 600px) { .team-person:nth-of-type(3) .team-person-label { left: auto; right: 2px; transform: none; } }
  @container (max-width: 600px) { .team-person-label { padding: 6px 8px; font-size: 10px; } .team-person-origin { width: 6px; height: 6px; border-width: 1px; box-shadow: 0 0 0 2px rgb(240 233 222 / .18); } }
  @media (hover: none) { .touch-hint { display: inline; } .pointer-hint { display: none; } }
  @media (max-width: 600px) { .team-person-label { padding: 6px 8px; font-size: 10px; } .team-person-origin { width: 6px; height: 6px; border-width: 1px; box-shadow: 0 0 0 2px rgb(240 233 222 / .18); } .team-photo-hint { font-size: 12px; } }
  @media (prefers-reduced-motion: reduce) { .team-person-label { transition: none; animation: none; } .team-person-trace path { animation: none; stroke-dashoffset: 0; } .name-letter { animation: none; opacity: 1; } .team-person-origin { animation: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-team-photo]').forEach(photo => {
    const people = photo.querySelectorAll<HTMLButtonElement>('[data-team-person]');
    const dismissAll = () => people.forEach(person => person.classList.remove('is-active'));
    people.forEach(person => {
      person.addEventListener('click', () => {
        const active = person.classList.contains('is-active');
        dismissAll();
        person.classList.remove('is-dismissed');
        person.classList.toggle('is-active', !active);
      });
      person.addEventListener('pointerenter', () => person.classList.remove('is-dismissed'));
      person.addEventListener('pointerleave', event => {
        if (event.pointerType === 'mouse') person.classList.remove('is-active');
      });
      person.addEventListener('focus', () => person.classList.remove('is-dismissed'));
      person.addEventListener('blur', () => person.classList.remove('is-active'));
    });
    document.addEventListener('click', event => {
      if (event.target instanceof Element && !event.target.closest('[data-team-person]')) dismissAll();
    });
    document.addEventListener('keydown', event => {
      if (event.key !== 'Escape') return;
      dismissAll();
      people.forEach(person => person.classList.add('is-dismissed'));
    });
  });
</script>
