---
interface Props {
  people: ReadonlyArray<{ name: string; image: string; role: string; bio: string }>;
}
const { people } = Astro.props;
---
<div class="team-portraits">
  {people.map(person => <article class="team-profile">
    <img src={`/assets/img/${person.image}`} alt={person.name} width="560" height="560" loading="lazy" />
    <h3>{person.name}</h3>
    <p>{person.bio}</p>
  </article>)}
</div>
<style>
  .team-portraits { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 28px; }
  .team-profile { min-width: 0; }
  .team-profile img { width: min(100%, 220px); aspect-ratio: 1; object-fit: cover; border-radius: 50%; margin-bottom: 20px; }
  .team-profile h3 { font-size: 20px; line-height: 1.3; margin-bottom: 10px; font-weight: 600; }
  .team-profile p { font-size: 15px; line-height: 1.55; color: var(--muted); }
  @media (max-width: 540px) {
    .team-portraits { gap: 28px 18px; }
    .team-profile h3 { font-size: 17px; }
    .team-profile p { font-size: 14px; }
  }
</style>
