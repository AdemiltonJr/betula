---
import { clients } from '../../data/site';
---
<section class="client-roster section-space" id="clientes" aria-labelledby="clients-title">
  <div class="client-heading"><h2 id="clients-title">Empresas que fazem parte<br /><span>da nossa trajetória.</span></h2><p>Negócios diferentes.<br />O mesmo cuidado com cada conexão.</p></div>
  <ul class="client-logos" role="list">
    {clients.map(([file, name]) => <li class:list={[{ 'client-dark': name === 'Isorecort' || name === 'Clínica da Cidade' }]}>
      {file ? <img src={`/assets/img/${file}`} alt={name} width="200" height="90" loading="lazy" /> : <span class="client-name">{name}</span>}
    </li>)}
  </ul>
</section>
<style>
  .client-roster { padding-top: 65px; padding-bottom: 65px; }
  .client-heading { display: flex; align-items: end; justify-content: space-between; gap: 32px; margin-bottom: 35px; }
  .client-heading h2 { font-size: clamp(28px, 2.8vw, 40px); }
  .client-heading p { font-size: 16px; color: var(--muted); }
  .client-logos { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 1px; background: var(--line); list-style: none; }
  .client-logos li { min-width: 0; height: 110px; display: flex; align-items: center; justify-content: center; padding: 20px 22px; background: white; }
  .client-logos img { width: 100%; max-width: 200px; height: 100%; object-fit: contain; }
  .client-logos .client-dark { background: #175537; }
  .client-name { font-family: var(--title); text-align: center; font-size: 18px; line-height: 1.3; }
  @media (max-width: 1050px) { .client-logos { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .client-heading { display: block; }
    .client-heading p { margin-top: 18px; }
    .client-logos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .client-logos li { height: 98px; padding: 18px; }
  }
</style>
