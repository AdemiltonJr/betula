---
const waContratar =
  'https://api.whatsapp.com/send?phone=5519981389865&text=Ol%C3%A1!%20Quero%20contratar%20um%20processo%20de%20recrutamento%20e%20sele%C3%A7%C3%A3o.';

const selos = [
  { n: '+20 anos', d: 'de experiência em R&S' },
  { n: 'Campinas-SP', d: 'e todo o Brasil' },
  { n: 'Cultural fit', d: 'foco em assertividade' },
];
---

<section class="hero hero-editorial">
  <div class="hero-pattern" aria-hidden="true"></div>

  <div class="container hero-ed-grid">
    <div class="hero-ed-copy reveal">
      <span class="eyebrow-ink"><span class="dot"></span> Bétula RH · Recrutamento e Seleção</span>
      <h1>Conectamos <span class="hl">pessoas e estratégia</span> para a sua empresa crescer.</h1>
      <p class="lead-ink">
        Solução integral em recrutamento e seleção, do operacional à gestão. Ligamos a cultura da
        sua organização aos profissionais certos, com processos éticos e assertivos.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href={waContratar} target="_blank" rel="noopener">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.38a9.9 9.9 0 0 0 4.74 1.2h.01c5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.14.82.84-3.06-.2-.31a8.18 8.18 0 1 1 7.18 3.87Z"></path></svg>
          Quero contratar
        </a>
        <a class="btn btn-ghost btn-lg" href="#metodo">Como atuamos</a>
      </div>
      <ul class="hero-selos">
        {
          selos.map((s) => (
            <li>
              <strong>{s.n}</strong>
              <span>{s.d}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-ed-visual reveal" aria-hidden="true">
      <div class="hero-circle">
        <img src="/assets/img/hero-birch.jpg" alt="" width="900" height="900" fetchpriority="high" />
      </div>
    </div>
  </div>
</section>
